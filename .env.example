# Copy to ~/.config/google-data-mcp/.env (or a .env next to index.mjs) and fill in.
# Client ID/secret: Google Cloud Console → APIs & Services → Credentials → OAuth client (Desktop app).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Filled by `npm run auth` (read-only) and `npm run auth -- --write` (GA4/GTM write + publish).
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_REFRESH_TOKEN_WRITE=

# Optional
# GOOGLE_DATA_MCP_READONLY=1             # hide all write tools, always use the read-only token
# GOOGLE_DATA_MCP_BACKUP_DIR=/path       # default ~/.config/google-data-mcp/backups
# GOOGLE_DATA_MCP_MAX_OUTPUT=50000       # max characters per tool response
